rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /annotations/{annotation} {
      allow read: if true;  // 誰でも読み取り可能
      allow create: if request.auth != null;  // 認証済みユーザーのみ作成可能
      allow update, delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;  // 作成者のみ更新・削除可能
    }

    match /routes/{route} {
      allow read: if true;  // 誰でも読み取り可能
      allow create: if request.auth != null;  // 認証済みユーザーのみ作成可能
      allow update, delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;  // 作成者のみ更新・削除可能
    }

    // ユーザ単位のメタデータ語彙（設定画面で編集 / アノテーション入力の候補に使用）。
    // ドキュメント ID = userId。本人のみ read/write 可能。
    match /metadata_vocabularies/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
