# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-your_measurement_id

# Firebase Admin SDK (Base64 encoded service account JSON)
# Generate with: cat your-service-account.json | base64
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_service_account

# Mirador Viewer URL
NEXT_PUBLIC_MIRADOR_URL=https://nakamura196.github.io/mirador-annotations/

# Google Analytics (任意)
# 未設定なら NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID を計測IDとして再利用する。
# 専用の GA4 プロパティを使う場合のみ設定する。
NEXT_PUBLIC_GA_ID=G-your_measurement_id

# メンテナンス（作業停止）モード (任意)
# 1 または true で有効化すると、書き込み API が 503 を返しエディタにバナーが出る（読み取りは継続）。
# 再デプロイで確実に固定したい時に使う。再デプロイなしで即時 ON/OFF したい場合は
# Firestore の system/maintenance フラグを使う（admin リポの scripts/maintenance.js）。
# MAINTENANCE_MODE=1
# MAINTENANCE_MESSAGE=データ移行のため一時的に保存できません。しばらくお待ちください。
