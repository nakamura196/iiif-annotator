{
  "name": "iiif-annotator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --port 3111",
    "prebuild": "mkdir -p public/models public/config && cp -r node_modules/@nakamura196/ndl-koten-ocr-web/models/* public/models/ && cp node_modules/@nakamura196/ndl-koten-ocr-web/models/NDLmoji.yaml public/config/",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:op": "op run --env-file=.env.local -- npm run dev",
    "start:op": "op run --env-file=.env.local -- npm run start"
  },
  "dependencies": {
    "@annotorious/annotorious": "3.7.4",
    "@annotorious/openseadragon": "3.7.4",
    "@annotorious/react": "3.7.4",
    "@ckeditor/ckeditor5-react": "^9.5.0",
    "@iiif/parser": "^2.2.1",
    "@iiif/presentation-3": "^2.2.3",
    "@nakamura196/ndl-koten-ocr-web": "^1.0.0",
    "@nakamura196/react-ui": "github:nakamura196/react-ui#v0.5.0",
    "@next/third-parties": "^16.1.6",
    "@opentelemetry/api": "^1.9.0",
    "@swc/helpers": "^0.5.18",
    "ckeditor5": "^48.2.0",
    "ckeditor5-premium-features": "^48.2.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.6.0",
    "js-yaml": "^4.3.0",
    "lucide-react": "^0.513.0",
    "next": "^16.2.6",
    "next-intl": "^4.9.2",
    "next-themes": "^0.4.6",
    "onnxruntime-web": "^1.22.0",
    "openseadragon": "^5.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "3.0.6",
    "sonner": "2.0.7",
    "xml-formatter": "^3.6.6"
  },
  "overrides": {
    "@ckeditor/ckeditor5-ai": {
      "@aws-sdk/client-bedrock-runtime": "^3.894.0"
    },
    "protobufjs": ">=8.6.5",
    "fast-xml-parser": ">=5.6.1",
    "flatted": ">=3.4.2",
    "node-forge": ">=1.4.0",
    "socket.io-parser": ">=4.2.6",
    "@grpc/grpc-js": ">=1.14.4",
    "esbuild": ">=0.28.1",
    "picomatch": ">=2.3.2 <3",
    "ws": ">=8.21.0",
    "qs": ">=6.15.3",
    "postcss": ">=8.5.10",
    "js-yaml": "$js-yaml",
    "@tootallnate/once": ">=2.0.1 <3",
    "uuid": "11.1.1",
    "form-data": ">=4.0.6",
    "@types/request": {
      "form-data": ">=2.5.6 <3"
    },
    "brace-expansion@>=5.0.0 <5.0.6": "5.0.6",
    "@babel/core@<=7.29.0": "7.29.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/openseadragon": "^4.1.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.34.0",
    "eslint-config-next": "^16.1.6",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.6"
  }
}
